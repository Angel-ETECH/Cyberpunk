<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#070F18">
 <Grid.Resources>
  <SolidColorBrush x:Key="Accent" Color="#EAFF5A"/>
  <SolidColorBrush x:Key="Muted" Color="#9CAEB9"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E7EEF2"/><Setter Property="Background" Value="#99101F2B"/><Setter Property="BorderBrush" Value="#46526570"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="19,12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#DD263C46"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <Image x:Name="Scene" Stretch="UniformToFill"/>
 <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C607111E" Offset="0"/><GradientStop Color="#6A07111E" Offset="0.29"/><GradientStop Color="#0007111E" Offset="0.7"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
 <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#65030B13" Offset="0"/><GradientStop Color="#00040B13" Offset="0.4"/><GradientStop Color="#10040B13" Offset="0.66"/><GradientStop Color="#D9040B13" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
 <Grid x:Name="RainHost" IsHitTestVisible="False"/>
 <Viewbox Stretch="Uniform"><Grid Width="1600" Height="900">
  <Grid Margin="68,44,68,0" VerticalAlignment="Top" Height="48">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Accent}" CornerRadius="3" Width="39" Height="39" Margin="0,0,14,0"><TextBlock Text="E/" FontFamily="Arial" FontStyle="Italic" FontWeight="Black" FontSize="23" Foreground="#101A22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="EDGERUNNER" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" Foreground="#F1F6F8"/><TextBlock Text="P E R S O N A L   D E S K T O P" FontFamily="Consolas" FontSize="8" Foreground="#8A9EAE" Margin="0,4,0,0"/></StackPanel><Border Width="1" Background="#4B6A7C" Margin="26,7"/><TextBlock Text="NIGHTFALL / 01" Foreground="#9BAFBF" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/></StackPanel>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#82E7D4" Width="5" Height="5" Margin="0,0,9,0"/><TextBlock x:Name="Network" Text="RED LOCAL" Foreground="#C5D7E2" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SettingsButton" Content="☷  Ajustes" Margin="25,0,0,0" FontSize="11" Padding="15,10"/></StackPanel>
  </Grid>
  <StackPanel x:Name="ClockGroup" Margin="78,181,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
   <StackPanel Orientation="Horizontal"><Rectangle Width="28" Height="2" Fill="{DynamicResource Accent}" Margin="0,0,12,0"/><TextBlock Text="TU TIEMPO. TU CIUDAD." FontFamily="Consolas" FontSize="10" Foreground="#BDCAD3"/></StackPanel>
   <StackPanel Orientation="Horizontal" Margin="-5,7,0,0"><TextBlock x:Name="Hours" Text="00" FontFamily="Segoe UI Light" FontWeight="Light" FontSize="118" Foreground="#F5F9FC"/><TextBlock Text=":" FontFamily="Segoe UI Light" FontSize="107" Foreground="{DynamicResource Accent}" Margin="-1,-2,-1,0"/><TextBlock x:Name="Minutes" Text="00" FontFamily="Segoe UI Light" FontSize="118" Foreground="#F5F9FC"/><StackPanel VerticalAlignment="Bottom" Margin="18,0,0,26"><TextBlock x:Name="Seconds" Text="00" Foreground="{DynamicResource Accent}" FontSize="23" FontFamily="Consolas"/><TextBlock Text="LOCAL" Foreground="#91A8B9" FontSize="8" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel></StackPanel>
   <TextBlock x:Name="Date" Text="MARTES, 27 OCTUBRE" FontFamily="Segoe UI" FontSize="15" Foreground="#D4E0E8" Margin="4,-4,0,0"/>
   <TextBlock Text="Qué bueno estar de vuelta." Foreground="#8CA4B7" FontFamily="Segoe UI" FontSize="12" Margin="4,13,0,0"/>
  </StackPanel>
  <StackPanel x:Name="TelemetryGroup" Margin="78,0,0,136" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="374">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,11"><TextBlock Text="SISTEMA" Foreground="#C6D6DF" FontFamily="Consolas" FontSize="10"/><TextBlock Text=" / EN TIEMPO REAL" Foreground="#7994A8" FontFamily="Consolas" FontSize="10"/></StackPanel>
   <Border CornerRadius="12" BorderBrush="#505A7180" BorderThickness="1" Padding="22,19" Background="#D00A1724">
    <StackPanel>
     <Grid><TextBlock Text="PROCESADOR" Foreground="#AEC0CD" FontFamily="Consolas" FontSize="10"/><TextBlock x:Name="CpuText" Text="—" Foreground="#F0F6FA" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"/></Grid>
     <Grid Height="3" Margin="0,12,0,19" Background="#263B4A"><Border x:Name="CpuBar" Width="0" Background="{DynamicResource Accent}" HorizontalAlignment="Left" CornerRadius="2"/></Grid>
     <Grid><TextBlock Text="MEMORIA RAM" Foreground="#AEC0CD" FontFamily="Consolas" FontSize="10"/><TextBlock x:Name="RamText" Text="—" Foreground="#F0F6FA" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"/></Grid>
     <Grid Height="3" Margin="0,12,0,18" Background="#263B4A"><Border x:Name="RamBar" Width="0" Background="#78D7DC" HorizontalAlignment="Left" CornerRadius="2"/></Grid>
     <Grid><TextBlock x:Name="DiskText" Text="DISCO —" Foreground="#8CA6B9" FontFamily="Consolas" FontSize="9"/><TextBlock x:Name="BatteryText" Text="BATERÍA —" Foreground="#8CA6B9" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/></Grid>
    </StackPanel>
   </Border>
  </StackPanel>
  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,76,143"><TextBlock Text="N I G H T F A L L" Foreground="#DFECF3" FontSize="13" FontFamily="Segoe UI" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock Text="SOMEWHERE BEYOND THE ORDINARY." Foreground="#7E9AAE" FontSize="8" FontFamily="Consolas" Margin="0,8,0,0"/></StackPanel>
  <Grid Margin="78,0,78,48" Height="55" VerticalAlignment="Bottom">
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ModeLabel" Text="VISTA PREVIA" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="ModeHint" Text="Hecho para tu escritorio." FontSize="11" Foreground="#8FA9BC" Margin="0,7,0,0"/></StackPanel>
   <StackPanel x:Name="PreviewActions" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ApplyButton" Content="Activar en mi escritorio  ↗" Background="{DynamicResource Accent}" Foreground="#101C22" FontWeight="SemiBold" BorderBrush="{DynamicResource Accent}" Padding="25,12"/><Button x:Name="ExitButton" Content="Cerrar" Margin="12,0,0,0" Padding="20,12"/></StackPanel>
   <TextBlock x:Name="DesktopHint" Text="AJUSTES Y ACCESOS  /  ICONO E JUNTO AL RELOJ DE WINDOWS" FontFamily="Consolas" FontSize="8" Foreground="#7895A9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid>
 </Grid></Viewbox>
</Grid>
